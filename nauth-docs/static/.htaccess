# Apache config for Docusaurus with trailingSlash: false
# Serves extensionless URLs from their .html files and normalizes trailing slashes.

DirectorySlash Off
Options -Indexes
RewriteEngine On

# Canonical host: redirect www.nauth.dev -> nauth.dev (apex).
# Runs first so the host is normalized before any path rewrites; preserves the
# full path + query string. Prevents split assets and duplicate-content/canonical issues.
RewriteCond %{HTTP_HOST} ^www\.nauth\.dev$ [NC]
RewriteRule ^ https://nauth.dev%{REQUEST_URI} [R=301,L]

# /page/ -> /page when page.html exists (canonical, avoids duplicate URLs)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Extensionless URL -> .html file (also covers /changelog where a dir of the same name exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html
