# nauth-docs is a standalone project (installed with --ignore-workspace), not part of
# the monorepo's pnpm-workspace.yaml. shamefully-hoist=true is required here too: the
# swizzled components under src/theme/ import @docusaurus/* packages that are only
# transitive deps of @docusaurus/core / preset-classic, and Docusaurus's webpack/rspack
# config resolves those from a flat root node_modules. (The "Cannot mix different
# versions of joi schemas" error this used to trigger is fixed via the joi override in
# package.json instead, so hoisting can stay on.)
shamefully-hoist=true
