{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    // Keep the build cache out of dist/. rootDir is the package root here (both src/
    // and nestjs/ are compiled), so tsc would otherwise drop a ~500 kB
    // tsconfig.tsbuildinfo inside dist/ and `files: ["dist"]` would publish it.
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "nestjs/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"],
  "references": [{ "path": "../core" }, { "path": "../nestjs" }]
}
