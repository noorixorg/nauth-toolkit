{
  "name": "@nauth-toolkit/database-typeorm-mysql",
  "version": "0.2.2",
  "description": "MySQL storage adapter for nauth-toolkit via TypeORM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "peerDependencies": {
    "@nauth-toolkit/core": "^0.2.2",
    "typeorm": "^0.3.20",
    "mysql2": "^2.3.0 || ^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "SEE LICENSE",
  "keywords": [
    "nauth",
    "authentication",
    "auth",
    "nodejs",
    "typescript",
    "typeorm",
    "mysql",
    "mariadb",
    "database",
    "storage"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noorixorg/nauth"
  },
  "homepage": "https://nauth.dev",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
