{
  "name": "@nauth-toolkit/mfa-sms",
  "version": "0.1.81",
  "description": "SMS MFA provider for nauth-toolkit",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": [
        "dist/nestjs/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./nestjs": {
      "import": "./dist/nestjs/index.js",
      "require": "./dist/nestjs/index.js",
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "peerDependencies": {
    "@nauth-toolkit/core": "^0.1.81"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "UNLICENSED",
  "keywords": [
    "nestjs",
    "authentication",
    "mfa",
    "sms",
    "2fa"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
