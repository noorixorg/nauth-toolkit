<mjml>
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ previewText }}</mj-preview>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <mj-attributes>
      <!-- Global font family for all components -->
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      />

      <!-- Text defaults -->
      <mj-text font-size="16px" line-height="24px" color="#374151" padding="0 24px 16px 24px" align="left" />

      <!-- Button defaults -->
      <mj-button
        font-size="16px"
        font-weight="600"
        border-radius="8px"
        background-color="#4f46e5"
        color="#ffffff"
        padding="16px 32px"
        align="center"
      />

      <!-- Section defaults -->
      <mj-section padding="0 24px" background-color="#ffffff" />

      <!-- Column defaults -->
      <mj-column background-color="#ffffff" />

      <!-- Divider defaults -->
      <mj-divider border-color="#e5e7eb" border-width="1px" />
    </mj-attributes>
    <mj-style>
      /* Global CSS classes for reusable styles */
      .text-primary {
        color: #111827;
      }
      .text-secondary {
        color: #374151;
      }
      .text-muted {
        color: #6b7280;
      }
      .text-small {
        color: #9ca3af;
      }
      .text-success {
        color: #166534;
      }
      .text-danger {
        color: #dc2626;
      }
      .text-info {
        color: #0c4a6e;
      }

      .bg-success {
        background-color: #f0fdf4;
      }
      .bg-danger {
        background-color: #fef2f2;
      }
      .bg-info {
        background-color: #f0f9ff;
      }
      .bg-muted {
        background-color: #f9fafb;
      }

      .font-bold {
        font-weight: 600;
      }
      .font-semibold {
        font-weight: 500;
      }

      .heading {
        font-size: 18px;
        font-weight: 600;
        color: #111827;
      }
      .heading-large {
        font-size: 20px;
        font-weight: 600;
        color: #111827;
      }
      .text-small {
        font-size: 14px;
      }
      .text-xs {
        font-size: 12px;
      }

      .code-block {
        font-size: 48px !important;
        font-weight: 700 !important;
        letter-spacing: 12px !important;
        color: #111827 !important;
        background-color: #f9fafb !important;
        padding: 20px !important;
        text-align: center !important;
      }
      .code-block div {
        font-size: 48px !important;
        font-weight: 700 !important;
        letter-spacing: 12px !important;
        color: #111827 !important;
        background-color: #f9fafb !important;
        padding: 20px !important;
        text-align: center !important;
      }

      .alert-box {
        padding: 16px 24px;
        border-left: 4px solid;
      }
      .alert-success {
        background-color: #f0fdf4;
        border-left-color: #22c55e;
        color: #166534;
      }
      .alert-danger {
        background-color: #fef2f2;
        border-left-color: #ef4444;
        color: #991b1b;
      }
      .alert-info {
        background-color: #f0f9ff;
        border-left-color: #0ea5e9;
        color: #0c4a6e;
      }

      a {
        color: #4f46e5;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      ul {
        margin: 0;
        padding-left: 20px;
        color: #374151;
      }
      li {
        margin-bottom: 8px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-wrapper background-color="#f3f4f6" padding="0">
      <!-- Header -->
      <mj-section background-color="#ffffff" padding="0">
        <mj-column>
          <mj-divider border-color="#e5e7eb" border-width="1px" padding="0" />
        </mj-column>
      </mj-section>

      <!-- Logo/Header Section (Optional) -->
      <mj-raw>
        {{#if logoUrl}}
      </mj-raw>
      <mj-section background-color="#ffffff" padding="32px 24px">
        <mj-column>
          <mj-image src="{{logoUrl}}" alt="{{appName}}" width="200px" align="center" padding="0" />
        </mj-column>
      </mj-section>
      <mj-raw>
        {{/if}}
      </mj-raw>

      <!-- Main Content Card -->
      <mj-section>
        <mj-column>
          <!-- Greeting (render if any name field is provided) -->
          <mj-raw>
            {{#if fullName}}
          </mj-raw>
          <mj-text css-class="heading" padding="32px 24px 16px 24px"> Hi {{ fullName }}, </mj-text>
          <mj-raw>
            {{/if}}
            {{#if firstName}}
          </mj-raw>
          <mj-text css-class="heading" padding="32px 24px 16px 24px"> Hi {{ firstName }}, </mj-text>
          <mj-raw>
            {{/if}}
            {{#if lastName}}
          </mj-raw>
          <mj-text css-class="heading" padding="32px 24px 16px 24px"> Hi {{ lastName }}, </mj-text>
          <mj-raw>
            {{/if}}
            {{#if userName}}
          </mj-raw>
          <mj-text css-class="heading" padding="32px 24px 16px 24px"> Hi {{ userName }}, </mj-text>
          <mj-raw>
            {{/if}}
          </mj-raw>

          <!-- Content Slot - Child template injected here -->
          <mj-include path="./content/{{templateName}}.mjml" />
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section padding="24px">
        <mj-column>
          <mj-divider padding="16px 0" />
          <mj-text font-size="14px" color="#6b7280" align="center" padding="8px 0">
            &copy; {{ currentYear }} {{ companyName }}. All rights reserved.
          </mj-text>
          <mj-raw>
            {{#if supportEmail}}
          </mj-raw>
          <mj-text font-size="14px" color="#6b7280" align="center" padding="8px 0">
            Need help? <a href="mailto:{{supportEmail}}">Contact Support</a>
          </mj-text>
          <mj-raw>
            {{/if}}
          </mj-raw>
          <!-- Footer Disclaimer (custom or default) -->
          <mj-raw>
            {{#if footerDisclaimer}}
          </mj-raw>
          <mj-text font-size="12px" color="#6b7280" align="center" padding="16px 24px 8px 24px" line-height="18px">
            {{ footerDisclaimer }}
          </mj-text>
          <mj-raw>
            {{else}}
          </mj-raw>
          <mj-text font-size="12px" color="#6b7280" align="center" padding="16px 24px 8px 24px" line-height="18px">
            This email and any attachments are confidential and intended solely for the use of the individual or entity
            to whom they are addressed. If you have received this email in error, please notify the sender immediately
            and delete it from your system. Any unauthorized use, disclosure, copying, or distribution of this email is
            strictly prohibited.
          </mj-text>
          <mj-raw>
            {{/if}}
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
