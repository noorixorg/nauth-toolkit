<!-- MFA Enabled Email Content -->
<mj-text>
  Two-factor authentication has been successfully enabled for your account.
</mj-text>

<mj-text css-class="text-small alert-box alert-success" padding="16px 24px">
  Two-factor authentication enabled
</mj-text>

<mj-text css-class="text-small" padding="24px 24px 16px 24px">
  Your account is now more secure. You'll need to provide both your password and a verification code when logging in.
</mj-text>

<mj-raw>
  {{#if supportEmail}}
</mj-raw>
<mj-text css-class="text-small text-danger font-bold" padding="0 24px 24px 24px">
  If you didn't enable this feature, please contact support immediately at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>
