<!-- MFA Device Removed Email Content -->
<mj-text>
  An MFA device has been removed from your account.
</mj-text>

<mj-text css-class="text-small alert-box alert-warning" padding="16px 24px">
  Security alert: MFA device removed
</mj-text>

<mj-text css-class="text-small font-bold" padding="24px 24px 8px 24px">
  Device Details:
</mj-text>

<mj-text css-class="text-small" padding="0 24px 8px 24px">
  Type: {{deviceType}}
</mj-text>

<mj-raw>
  {{#if deviceName}}
</mj-raw>
<mj-text css-class="text-small" padding="0 24px 8px 24px">
  Name: {{deviceName}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text css-class="text-small" padding="0 24px 8px 24px">
  Removed by: {{removedBy}}
</mj-text>

<mj-raw>
  {{#if reason}}
</mj-raw>
<mj-text css-class="text-small" padding="0 24px 8px 24px">
  Reason: {{reason}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text css-class="text-small" padding="0 24px 24px 24px">
  Remaining devices: {{remainingDeviceCount}}
</mj-text>

<mj-raw>
  {{#if remainingDeviceCount}}
  {{#eq remainingDeviceCount 0}}
</mj-raw>
<mj-text css-class="text-small alert-box alert-danger" padding="16px 24px">
  Warning: You have no MFA devices remaining. Your account may be less secure.
</mj-text>
<mj-raw>
  {{/eq}}
  {{/if}}
</mj-raw>

<mj-text css-class="text-small" padding="24px 24px 8px 24px">
  If you made this change, no further action is required.
</mj-text>

<mj-raw>
  {{#if supportEmail}}
</mj-raw>
<mj-text css-class="text-small text-danger font-bold" padding="0 24px 24px 24px">
  If you didn't remove this device, please contact support immediately at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

