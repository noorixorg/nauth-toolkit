<!-- Email Changed Email Content -->
<mj-text>
  Your email address has been successfully changed to <strong>{{ userEmail }}</strong>.
</mj-text>

<mj-text css-class="text-small alert-box alert-success" padding="16px 24px"> Email change confirmed </mj-text>

<mj-text css-class="text-small" padding="24px 24px 8px 24px">
  If you made this change, no further action is required.
</mj-text>

<mj-raw>
  {{#if supportEmail}}
</mj-raw>
<mj-text css-class="text-small text-danger font-bold" padding="0 24px 24px 24px">
  If you didn't make this change, please contact support immediately at
  <a href="mailto:{{supportEmail}}">{{ supportEmail }}</a>.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>
