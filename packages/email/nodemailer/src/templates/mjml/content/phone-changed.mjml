<!-- Phone Changed Alert (to account email) Email Content -->
<mj-text>
  The phone number on your account has been changed.
</mj-text>

<mj-text css-class="text-small alert-box alert-warning" padding="16px 24px">
  Security Alert: Phone number changed
</mj-text>

<mj-text css-class="text-small font-bold" padding="24px 24px 8px 24px">
  Change Details:
</mj-text>

<mj-raw>
  {{#if oldPhone}}
</mj-raw>
<mj-text css-class="text-small" padding="0 24px 8px 24px">
  Previous number: {{oldPhone}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if newPhone}}
</mj-raw>
<mj-text css-class="text-small" padding="0 24px 8px 24px">
  New number: {{newPhone}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if timestamp}}
</mj-raw>
<mj-text css-class="text-small" padding="0 24px 24px 24px">
  When: {{timestamp}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if deactivatedMFADevices}}
  {{#gt deactivatedMFADevices 0}}
</mj-raw>
<mj-text css-class="text-small alert-box alert-info" padding="16px 24px">
  Because SMS codes were sent to the old number, {{deactivatedMFADevices}} SMS two-factor device(s) were removed with it.
</mj-text>
<mj-raw>
  {{/gt}}
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if mfaDisabled}}
</mj-raw>
<mj-text css-class="text-small alert-box alert-warning" padding="16px 24px">
  That leaves no two-factor method on your account, so two-factor authentication is now switched off. You will be asked to set it up again next time you sign in.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text css-class="text-small" padding="24px 24px 8px 24px">
  What should I do?
</mj-text>

<mj-text css-class="text-small" padding="0 24px 24px 24px">
  If you made this change, no action is required. You may want to set up two-factor authentication again on the new number.
</mj-text>

<mj-raw>
  {{#if supportEmail}}
</mj-raw>
<mj-text css-class="text-small text-danger font-bold" padding="0 24px 24px 24px">
  If you did not make this change, contact support immediately at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>. Someone else may control your account, and changing the number removes the second factor that protects it.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>
