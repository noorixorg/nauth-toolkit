<!-- Account Disabled Email Content -->
<mj-text>
  Your account has been disabled.
</mj-text>

<mj-text css-class="text-small alert-box alert-danger" padding="16px 24px">
  Account Status: Disabled
</mj-text>

<mj-raw>
  {{#if reason}}
</mj-raw>
<mj-text css-class="text-small font-bold" padding="24px 24px 8px 24px">
  Reason:
</mj-text>

<mj-text css-class="text-small" padding="0 24px 24px 24px">
  {{reason}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text css-class="text-small" padding="24px 24px 8px 24px">
  What does this mean?
</mj-text>

<mj-text css-class="text-small" padding="0 24px 24px 24px">
  Your account has been disabled and you will not be able to sign in. All active sessions have been terminated.
</mj-text>

<mj-raw>
  {{#if supportEmail}}
</mj-raw>
<mj-text css-class="text-small" padding="24px 24px 8px 24px">
  Need Help?
</mj-text>

<mj-text css-class="text-small" padding="0 24px 24px 24px">
  If you believe this is an error or need assistance, please contact support at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

