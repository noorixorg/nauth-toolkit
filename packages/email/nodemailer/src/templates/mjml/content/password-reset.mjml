<!-- Password Reset Email Content -->
<mj-text>
  We received a request to reset your password. Use the verification code below to create a new password.
</mj-text>

<!-- Code is required; always render it -->
<mj-text css-class="code-block" align="center" padding="16px 24px">
  <div>{{code}}</div>
</mj-text>

<mj-raw>
  {{#if link}}
</mj-raw>
<mj-button href="{{link}}">
  Reset Your Password
</mj-button>

<mj-text css-class="text-small text-muted" align="center" padding="24px 24px 16px 24px">
  Or copy and paste this URL into your browser:
</mj-text>
<mj-text css-class="text-xs text-small" padding="0 24px 16px 24px" align="center" font-family="monospace">
  {{link}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if expiryMinutes}}
</mj-raw>
<mj-text css-class="text-small text-muted" align="center" padding="0 24px 16px 24px">
  {{#if link}}This link expires in {{expiryMinutes}} minutes.{{else}}This code expires in {{expiryMinutes}} minutes.{{/if}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text css-class="text-small text-muted" padding="0 24px 24px 24px">
  If you didn't request a password reset, your account is secure and you can ignore this email.
</mj-text>

