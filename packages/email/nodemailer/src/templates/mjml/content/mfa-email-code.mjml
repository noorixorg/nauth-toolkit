<!-- MFA Email Code Content (Email MFA challenge; separate from signup verification) -->
<mj-text font-size="16px" line-height="24px" color="#374151" padding="0 24px 16px 24px">
  You're signing in to your account. Use the code below to complete two-factor authentication.
</mj-text>

<mj-raw>
  {{#if code}}
</mj-raw>
<mj-text font-size="14px" color="#6b7280" align="center" padding="16px 24px 8px 24px">
  Your verification code:
</mj-text>
<mj-text css-class="code-block" align="center" padding="20px 24px">
  {{ code }}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if expiryMinutes}}
</mj-raw>
<mj-text font-size="14px" color="#6b7280" padding="24px 24px 16px 24px">
  This code expires in {{ expiryMinutes }} minutes.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text font-size="14px" color="#6b7280" padding="0 24px 24px 24px">
  If you didn't request this code, please ignore this email and secure your account. {{#if supportEmail}}Contact support at {{supportEmail}}.{{/if}}
</mj-text>
