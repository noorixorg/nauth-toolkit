<!-- Admin Password Reset Email Content -->
<mj-text>
  An administrator initiated a password reset for your account. Use the code below to reset your password.
</mj-text>

<mj-raw>
  {{#if code}}
</mj-raw>
<mj-text font-size="14px" color="#6b7280" align="center" padding="16px 24px 8px 24px">
  Your Reset Code:
</mj-text>
<mj-text css-class="code-block" align="center" padding="20px 24px">
  {{ code }}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if link}}
</mj-raw>
<mj-button href="{{link}}">
  Reset Your Password
</mj-button>
<mj-text css-class="text-small text-muted" align="center" padding="24px 24px 16px 24px">
  Or copy and paste this URL into your browser:
</mj-text>
<mj-text css-class="text-xs text-small" padding="0 24px 16px 24px" align="center" font-family="monospace">
  {{link}}
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-raw>
  {{#if expiryMinutes}}
</mj-raw>
<mj-text font-size="14px" color="#6b7280" padding="24px 24px 16px 24px">
  This code expires in {{ expiryMinutes }} minutes.
</mj-text>
<mj-raw>
  {{/if}}
</mj-raw>

<mj-text font-size="14px" color="#6b7280" padding="0 24px 24px 24px">
  If you did not expect this email, contact support immediately.
</mj-text>


