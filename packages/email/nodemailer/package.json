{
  "name": "@nauth-toolkit/email-nodemailer",
  "version": "0.5.0",
  "description": "Nodemailer email provider for nauth-toolkit — SMTP, SES, Gmail",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/templates/default/**/*.hbs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build-templates && tsc -b && pnpm run copy-templates",
    "build-templates": "node src/templates/mjml/build-templates.js",
    "copy-templates": "cp -r src/templates/default dist/templates/",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.11"
  },
  "peerDependencies": {
    "@nauth-toolkit/core": "^0.5.0"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "mjml": "^4.17.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "license": "MIT",
  "keywords": [
    "nauth",
    "authentication",
    "auth",
    "nodejs",
    "typescript",
    "email",
    "nodemailer",
    "smtp",
    "ses"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noorixorg/nauth-toolkit"
  },
  "homepage": "https://nauth.dev",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
