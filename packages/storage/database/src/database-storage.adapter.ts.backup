import { Injectable, Inject, Optional } from '@nestjs/common';
import { Repository, LessThan, Like, FindOptionsWhere, DeleteResult } from 'typeorm';
import { StorageAdapter, NAuthException, AuthErrorCode, LoggerService } from '@nauth-toolkit/core';

/**
 * Type helper for repository operations with Record types
 * Used to avoid 'as any' assertions while working with dynamically typed repositories
 */
type RecordWhere = FindOptionsWhere<Record<string, unknown>>;
type RecordUpdate = Partial<Record<string, unknown>>;

/**
 * Database Storage Adapter
 *
 * Implements StorageAdapter interface using TypeORM repositories for persistent storage.
 * Stores transient state (rate limits, locks, token reuse tracking) in database tables.
 *
 * **Key Features:**
 * - Multi-server compatible (all servers share same database)
 * - Atomic operations via database-level increment/decrement
 * - TTL support via expiresAt column with scheduled cleanup
 * - Hash and list operations stored as JSON
 * - Seamlessly integrates with existing TypeORM DataSource
 *
 * **Database Tables:**
 * - `nauth_rate_limits`: Key-value pairs with expiration
 * - `nauth_storage_locks`: Distributed locks with expiration
 *
 * **Usage:**
 * ```typescript
 * import { DatabaseStorageAdapter } from '@nauth-toolkit/storage-database';
 *
 * AuthModule.forRoot({
 *   storageAdapter: new DatabaseStorageAdapter(), // Uses injected repositories
 * });
 * ```
 *
 * @example
 * ```typescript
 * const adapter = new DatabaseStorageAdapter();
 * await adapter.initialize();
 * await adapter.set('key', 'value', 60); // Set with 60 second TTL
 * const value = await adapter.get('key');
 * ```
 */
@Injectable()
export class DatabaseStorageAdapter implements StorageAdapter {
  /**
   * Creates a new DatabaseStorageAdapter instance
   *
   * @param rateLimitRepo - TypeORM repository for rate limit storage (injected)
   * @param storageLockRepo - TypeORM repository for distributed locks (injected)
   * @param logger - Logger service for error and debug logging
   * @throws {NAuthException} If repositories are not provided (entities not registered in TypeORM)
   */
  constructor(
    @Inject('RateLimitRepository')
    @Optional()
    private rateLimitRepo: Repository<Record<string, unknown>> | null,
    @Inject('StorageLockRepository')
    @Optional()
    private storageLockRepo: Repository<Record<string, unknown>> | null,
    @Inject('NAUTH_LOGGER')
    @Optional()
    private logger?: LoggerService,
  ) {
    // Repositories validation deferred to initialize() because:
    // - Factory-created adapters won't have repositories injected yet
    // - Repositories will be available when adapter is used as a provider
  }

  /**
   * Initialize the storage adapter
   * Performs health check to ensure repositories are accessible
   *
   * @throws {NAuthException} If repositories are not available
   */
  async initialize(): Promise<void> {
    // Validate repositories are available
    if (!this.rateLimitRepo || !this.storageLockRepo) {
      throw new NAuthException(
        AuthErrorCode.VALIDATION_FAILED,
        'RateLimit and StorageLock entities not found. Include them in getNAuthStorageEntities() when configuring TypeORM. ' +
          'Example: TypeOrmModule.forRoot({ entities: [...getNAuthEntities(), ...getNAuthStorageEntities()] })',
      );
    }

    try {
      await this.isHealthy();
      if (this.logger) {
        this.logger.log('DatabaseStorageAdapter initialized successfully');
      }
    } catch (error) {
      if (this.logger) {
        this.logger.error('Failed to initialize DatabaseStorageAdapter', error);
      }
      throw error;
    }
  }

  /**
   * Check if the storage adapter is healthy
   * Verifies database connection by checking repository accessibility
   *
   * @returns True if repositories are accessible
   */
  async isHealthy(): Promise<boolean> {
    try {
      // Try to query repositories to verify connection
      if (!this.rateLimitRepo || !this.storageLockRepo) {
        return false;
      }

      // Perform a lightweight query to check connectivity
      await this.rateLimitRepo.query('SELECT 1');
      return true;
    } catch (error) {
      if (this.logger) {
        this.logger.error('DatabaseStorageAdapter health check failed', error);
      }
      return false;
    }
  }

  /**
   * Set logger instance (called by AuthModule to inject logger after factory creation)
   *
   * @param logger - Logger service instance
   */
  setLogger(logger: LoggerService): void {
    this.logger = logger;
  }

  /**
   * Set repositories (called by AuthModule to inject repositories after factory creation)
   * This allows the adapter to be created in factories and repositories injected later
   *
   * @param rateLimitRepo - Rate limit repository
   * @param storageLockRepo - Storage lock repository
   */
  setRepositories(
    rateLimitRepo: Repository<Record<string, unknown>>,
    storageLockRepo: Repository<Record<string, unknown>>,
  ): void {
    this.rateLimitRepo = rateLimitRepo;
    this.storageLockRepo = storageLockRepo;
  }

  // ============================================================================
  // Basic Key-Value Operations
  // ============================================================================

  /**
   * Get a value by key
   * Automatically returns null if the key has expired
   *
   * @param key - The key to retrieve
   * @returns The stored value or null if not found/expired
   */
  async get(key: string): Promise<string | null> {
    const record = await this.rateLimitRepo!.findOne({
      where: { key } as RecordWhere,
    });

    if (!record) {
      return null;
    }

    // Check if expired
    const expiresAt = record.expiresAt as Date;
    if (expiresAt && expiresAt < new Date()) {
      // Auto-delete expired record
      await this.rateLimitRepo!.delete({ key } as RecordWhere);
      return null;
    }

    return (record.value as string) || null;
  }

  /**
   * Set a key-value pair with optional TTL (time to live)
   *
   * @param key - The key to store
   * @param value - The value to store
   * @param ttl - Time to live in seconds (optional)
   */
  async set(key: string, value: string, ttlSeconds?: number, options?: { nx?: boolean }): Promise<string | null> {
    const expiresAt = ttl ? new Date(Date.now() + ttl * 1000) : null;

    await this.rateLimitRepo!.upsert(
      {
        key,
        value,
        expiresAt,
      } as RecordUpdate,
      ['key'] as (keyof Record<string, unknown>)[],
    );
  }

  /**
   * Delete a key from storage
   *
   * @param key - The key to delete
   */
  async del(key: string): Promise<void> {
    await this.rateLimitRepo!.delete({ key } as RecordWhere);
    // Also delete from locks if exists
    await this.storageLockRepo!.delete({ key } as RecordWhere);
  }

  /**
   * Check if a key exists and is not expired
   *
   * @param key - The key to check
   * @returns True if key exists and is valid, false otherwise
   */
  async exists(key: string): Promise<boolean> {
    const value = await this.get(key);
    return value !== null;
  }

  // ============================================================================
  // Atomic Operations (for counters and rate limiting)
  // ============================================================================

  /**
   * Increment a counter stored at key
   * Uses TypeORM transaction with pessimistic locking for thread-safety
   *
   * @param key - The key to increment
   * @returns The new value after incrementing
   */
  async incr(key: string): Promise<number> {
    return await this.rateLimitRepo!.manager.transaction(async (transactionalEntityManager) => {
      // Lock the row for update to ensure atomicity
      const record = await transactionalEntityManager.findOne(this.rateLimitRepo!.target, {
        where: { key } as RecordWhere,
        lock: { mode: 'pessimistic_write' },
      });

      if (record) {
        // Update existing record
        const currentValue = parseInt(record.value as string, 10) || 0;
        const newValue = currentValue + 1;

        await transactionalEntityManager.update(
          this.rateLimitRepo!.target,
          { key } as RecordWhere,
          { value: newValue.toString() } as RecordUpdate,
        );

        return newValue;
      } else {
        // Key doesn't exist - create with value 1
        // Set a default expiration of 24 hours to prevent orphaned counters
        const defaultExpiration = new Date(Date.now() + 24 * 60 * 60 * 1000); // 24 hours
        await transactionalEntityManager.save(this.rateLimitRepo!.target, {
          key,
          value: '1',
          expiresAt: defaultExpiration,
        } as RecordUpdate);

        return 1;
      }
    });
  }

  /**
   * Decrement a counter stored at key
   * Uses TypeORM transaction with pessimistic locking for thread-safety
   *
   * @param key - The key to decrement
   * @returns The new value after decrementing (minimum 0)
   */
  async decr(key: string): Promise<number> {
    return await this.rateLimitRepo!.manager.transaction(async (transactionalEntityManager) => {
      // Lock the row for update to ensure atomicity
      const record = await transactionalEntityManager.findOne(this.rateLimitRepo!.target, {
        where: { key } as RecordWhere,
        lock: { mode: 'pessimistic_write' },
      });

      if (record) {
        // Update existing record
        const currentValue = parseInt(record.value as string, 10) || 0;
        const newValue = Math.max(0, currentValue - 1); // Don't allow negative

        await transactionalEntityManager.update(
          this.rateLimitRepo!.target,
          { key } as RecordWhere,
          { value: newValue.toString() } as RecordUpdate,
        );

        return newValue;
      } else {
        // Key doesn't exist - create with value 0
        // Set a default expiration of 24 hours to prevent orphaned counters
        const defaultExpiration = new Date(Date.now() + 24 * 60 * 60 * 1000); // 24 hours
        await transactionalEntityManager.save(this.rateLimitRepo!.target, {
          key,
          value: '0',
          expiresAt: defaultExpiration,
        } as RecordUpdate);

        return 0;
      }
    });
  }

  /**
   * Set expiration time on an existing key
   *
   * @param key - The key to set expiration on
   * @param ttl - Time to live in seconds
   */
  async expire(key: string, ttl: number): Promise<void> {
    const expiresAt = new Date(Date.now() + ttl * 1000);

    await this.rateLimitRepo!.update({ key } as RecordWhere, { expiresAt } as RecordUpdate);
  }

  /**
   * Get the time to live (TTL) for a key
   *
   * @param key - The key to check
   * @returns Seconds until expiration, -1 if no expiration, -2 if key doesn't exist
   */
  async ttl(key: string): Promise<number> {
    const record = await this.rateLimitRepo!.findOne({
      where: { key } as RecordWhere,
    });

    if (!record) {
      return -2; // Key doesn't exist
    }

    const expiresAt = record.expiresAt as Date;
    if (!expiresAt) {
      return -1; // No expiration
    }

    const remaining = Math.floor((expiresAt.getTime() - Date.now()) / 1000);
    return remaining > 0 ? remaining : -2; // -2 if already expired
  }

  // ============================================================================
  // Hash Operations (stored as JSON)
  // ============================================================================

  /**
   * Get a field value from a hash
   * Hash is stored as JSON in the value field
   *
   * @param key - Hash key (prefixed with "hash:")
   * @param field - Field name
   * @returns Field value or null if not found
   */
  async hget(key: string, field: string): Promise<string | null> {
    const hashKey = `hash:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: hashKey } as RecordWhere,
    });

    if (!record) {
      return null;
    }

    try {
      const hash = JSON.parse(record.value as string);
      return hash[field] || null;
    } catch {
      return null;
    }
  }

  /**
   * Set a field value in a hash
   *
   * @param key - Hash key
   * @param field - Field name
   * @param value - Field value
   */
  async hset(key: string, field: string, value: string): Promise<void> {
    const hashKey = `hash:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: hashKey } as RecordWhere,
    });

    let hash: Record<string, string> = {};
    if (record) {
      try {
        hash = JSON.parse(record.value as string);
      } catch {
        // Invalid JSON - start fresh
      }
    }

    hash[field] = value;

    await this.rateLimitRepo!.upsert(
      {
        key: hashKey,
        value: JSON.stringify(hash),
        expiresAt: record?.expiresAt || null,
      } as RecordUpdate,
      ['key'] as (keyof Record<string, unknown>)[],
    );
  }

  /**
   * Get all fields and values from a hash
   *
   * @param key - Hash key
   * @returns Object with all field-value pairs
   */
  async hgetall(key: string): Promise<Record<string, string>> {
    const hashKey = `hash:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: hashKey } as RecordWhere,
    });

    if (!record) {
      return {};
    }

    try {
      return JSON.parse(record.value as string);
    } catch {
      return {};
    }
  }

  /**
   * Delete one or more fields from a hash
   *
   * @param key - Hash key
   * @param fields - Field names to delete
   * @returns Number of fields deleted
   */
  async hdel(key: string, ...fields: string[]): Promise<number> {
    const hashKey = `hash:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: hashKey } as RecordWhere,
    });

    if (!record) {
      return 0;
    }

    try {
      const hash = JSON.parse(record.value as string);
      let deleted = 0;

      for (const field of fields) {
        if (Object.prototype.hasOwnProperty.call(hash, field)) {
          delete hash[field];
          deleted++;
        }
      }

      if (Object.keys(hash).length === 0) {
        // Empty hash - delete record
        await this.rateLimitRepo!.delete({ key: hashKey } as RecordWhere);
      } else {
        // Update record with remaining fields
        await this.rateLimitRepo!.update(
          { key: hashKey } as RecordWhere,
          { value: JSON.stringify(hash) } as RecordUpdate,
        );
      }

      return deleted;
    } catch {
      return 0;
    }
  }

  // ============================================================================
  // List Operations (stored as JSON array)
  // ============================================================================

  /**
   * Push value to the left (beginning) of a list
   *
   * @param key - List key (prefixed with "list:")
   * @param value - Value to push
   */
  async lpush(key: string, value: string): Promise<void> {
    const listKey = `list:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: listKey } as RecordWhere,
    });

    let list: string[] = [];
    if (record) {
      try {
        list = JSON.parse(record.value as string);
      } catch {
        // Invalid JSON - start fresh
      }
    }

    list.unshift(value); // Add to beginning

    await this.rateLimitRepo!.upsert(
      {
        key: listKey,
        value: JSON.stringify(list),
        expiresAt: record?.expiresAt || null,
      } as RecordUpdate,
      ['key'] as (keyof Record<string, unknown>)[],
    );
  }

  /**
   * Get a range of elements from a list
   *
   * @param key - List key
   * @param start - Start index (0-based)
   * @param stop - Stop index (-1 for end of list)
   * @returns Array of values in range
   */
  async lrange(key: string, start: number, stop: number): Promise<string[]> {
    const listKey = `list:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: listKey } as RecordWhere,
    });

    if (!record) {
      return [];
    }

    try {
      const list = JSON.parse(record.value as string);
      const end = stop === -1 ? list.length : stop + 1;
      return list.slice(start, end);
    } catch {
      return [];
    }
  }

  /**
   * Get the length of a list
   *
   * @param key - List key
   * @returns List length
   */
  async llen(key: string): Promise<number> {
    const listKey = `list:${key}`;
    const record = await this.rateLimitRepo!.findOne({
      where: { key: listKey } as RecordWhere,
    });

    if (!record) {
      return 0;
    }

    try {
      const list = JSON.parse(record.value as string);
      return list.length;
    } catch {
      return 0;
    }
  }

  // ============================================================================
  // Pattern Operations
  // ============================================================================

  /**
   * Find all keys matching a pattern
   * Uses LIKE query for pattern matching
   *
   * @param pattern - Glob pattern (* and ? wildcards)
   * @returns Array of matching keys
   */
  async keys(pattern: string): Promise<string[]> {
    // Convert glob pattern to SQL LIKE pattern
    const sqlPattern = pattern.replace(/\*/g, '%').replace(/\?/g, '_');

    const records = await this.rateLimitRepo!.find({
      where: { key: Like(sqlPattern) } as RecordWhere,
    });

    return records.map((r) => r.key as string);
  }

  /**
   * Iterate over keys matching a pattern (cursor-based)
   *
   * @param cursor - Cursor position (0 to start)
   * @param pattern - Glob pattern
   * @param count - Number of keys to return
   * @returns Tuple of [new cursor, keys array]
   */
  async scan(cursor: number, pattern: string, count: number): Promise<[number, string[]]> {
    const allKeys = await this.keys(pattern);
    const start = cursor;
    const end = Math.min(cursor + count, allKeys.length);
    const keys = allKeys.slice(start, end);
    const newCursor = end >= allKeys.length ? 0 : end;

    return [newCursor, keys];
  }

  // ============================================================================
  // Cleanup & Lifecycle
  // ============================================================================

  /**
   * Run cleanup of expired keys
   * Deletes all records where expiresAt < now()
   */
  async cleanup(): Promise<void> {
    const now = new Date();

    // Cleanup rate limits
    const deletedRateLimits: DeleteResult = await this.rateLimitRepo!.delete({
      expiresAt: LessThan(now),
    } as RecordWhere);

    // Cleanup storage locks
    const deletedLocks: DeleteResult = await this.storageLockRepo!.delete({
      expiresAt: LessThan(now),
    } as RecordWhere);

    if (this.logger?.debug) {
      this.logger.debug(
        `DatabaseStorageAdapter cleanup: deleted ${deletedRateLimits?.affected || 0} rate limits, ${deletedLocks?.affected || 0} locks`,
      );
    }
  }

  /**
   * Disconnect and cleanup all resources
   * No-op for database adapter (repositories are managed by TypeORM)
   */
  async disconnect(): Promise<void> {
    // No cleanup needed - repositories are managed by TypeORM DataSource
    if (this.logger?.debug) {
      this.logger.debug('DatabaseStorageAdapter disconnected');
    }
  }
}
