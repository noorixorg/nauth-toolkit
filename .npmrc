# Enforce strict engine requirements
engine-strict=true

# Hoist all dependencies to root node_modules for compatibility
# with Angular tooling, TypeORM decorators, and NestJS reflection
shamefully-hoist=true

# Don't fail on peer dependency mismatches (handle them as warnings)
strict-peer-dependencies=false

# NPM Authentication Token
# Token is read from ~/.npmrc (user-level config)
# To set: npm config set //registry.npmjs.org/:_authToken YOUR_NPM_TOKEN
