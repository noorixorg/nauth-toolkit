{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@nauth-toolkit/core": [
        "../../packages/core/dist/index"
      ],
      "@nauth-toolkit/core/*": [
        "../../packages/core/dist/*"
      ],
      "@nauth-toolkit/nestjs": [
        "../../packages/nestjs/dist/index"
      ],
      "@nauth-toolkit/nestjs/*": [
        "../../packages/nestjs/dist/*"
      ],
      "@nauth-toolkit/oidc-provider": [
        "../../packages/oidc-provider/dist/src/index"
      ],
      "@nauth-toolkit/oidc-provider/*": [
        "../../packages/oidc-provider/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
