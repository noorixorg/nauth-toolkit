# ========================================
# Application
# ========================================
PORT=3000
NODE_ENV=development

# Base URLs (used for CORS, OAuth callbacks, email links, passkey origins)
API_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:4200

# Extra CORS origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://app.example.com

# ========================================
# Database (PostgreSQL via TypeORM)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nauth_user
DB_PASSWORD=your_password_here
DB_DATABASE=nauth_sample

# ========================================
# Storage (Redis — sessions, rate limits, challenges)
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# JWT
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ========================================
JWT_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
# JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# ========================================
# Cookies (leave unset for localhost; set for cross-subdomain deployments)
# ========================================
# COOKIE_DOMAIN=.app.example.com

# ========================================
# Email branding (used by email templates)
# ========================================
APP_NAME=Nauth App
COMPANY_NAME=My Company
SUPPORT_EMAIL=support@example.com
# LOGO_URL=https://example.com/logo.png
# DASHBOARD_URL=http://localhost:4200/dashboard
# BRAND_COLOR=#4f46e5

# ========================================
# SMTP (only if you switch to NodemailerEmailProvider in auth.config.ts)
# ========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Nauth App <noreply@example.com>"

# ========================================
# Twilio SMS (only if you switch to TwilioSMSProvider in auth.config.ts)
# ========================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567

# ========================================
# Social login (each provider is enabled only when its client ID is set)
# ========================================
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# APPLE_SERVICE_ID=com.example.web
# APPLE_CLIENT_ID=com.example.app
# APPLE_TEAM_ID=YOURTEAMID
# APPLE_KEY_ID=YOURKEYID
# APPLE_P8_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ========================================
# Passkeys (WebAuthn)
# ========================================
# PASSKEY_RP_ID=localhost
# PASSKEY_TIMEOUT=60000

# ========================================
# reCAPTCHA Enterprise (only if recaptcha.enabled is true in auth.config.ts)
# ========================================
# RECAPTCHA_ENTERPRISE_PROJECT_ID=your-gcp-project-id
# RECAPTCHA_ENTERPRISE_API_KEY=AIza...
# RECAPTCHA_ENTERPRISE_SITE_KEY=6L...

# ========================================
# MaxMind GeoIP (optional — used for adaptive MFA geo risk factors)
# ========================================
# MAXMIND_ACCOUNT_ID=123456
# MAXMIND_LICENSE_KEY=your_license_key
