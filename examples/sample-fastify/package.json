{
  "name": "example-fastify",
  "version": "0.1.0",
  "description": "Fastify example demonstrating nauth-toolkit platform-agnostic usage",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "nodemon --exec ts-node src/index.ts",
    "test": "yarn build && node --test test/*.test.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@nauth-toolkit/core": "^0.1.6",
    "@nauth-toolkit/database-typeorm-postgres": "^0.1.6",
    "@nauth-toolkit/email-nodemailer": "^0.1.6",
    "@nauth-toolkit/sms-console": "^0.1.6",
    "@nauth-toolkit/storage-redis": "^0.1.6",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/formbody": "^7.4.0",
    "fastify": "^4.26.2",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "redis": "^5.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
