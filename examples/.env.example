# ============================================================================
# Nauth Demo - Ready to Deploy Configuration
# ============================================================================

# ============================================================================
# Domain Configuration - demo.nauth.dev (single domain)
# ============================================================================
FRONTEND_DOMAIN=demo.nauth.dev
API_DOMAIN=demo.nauth.dev
CADDY_EMAIL=admin@noorix.com

FRONTEND_BASE_URL=https://demo.nauth.dev
API_BASE_URL=https://demo.nauth.dev/api
PASSKEY_RP_ID=demo.nauth.dev
COOKIE_DOMAIN=

# ============================================================================
# CORS - Additional origins if needed (comma-separated)
# ============================================================================
# Leave empty for production
# Example for mobile: capacitor://localhost,ionic://localhost
ALLOWED_ORIGINS=

# ============================================================================
# Application
# ============================================================================
NODE_ENV=production
PORT=3000
TOKEN_MODE=cookies

# ============================================================================
# Database (AUTO-GENERATED on first run by start.sh)
# ============================================================================
# Password will be filled automatically - leave empty
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nauth_user
DB_PASSWORD=
DB_DATABASE=nauth_sample

# ============================================================================
# JWT Secrets (AUTO-GENERATED on first run by start.sh)
# ============================================================================
# These will be filled automatically - leave empty
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=60m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# App Branding
# ============================================================================
APP_NAME=Nauth Demo
COMPANY_NAME=Nauth
SUPPORT_EMAIL=support@nauth.dev
LOGO_URL=
DASHBOARD_URL=https://demo.nauth.dev/dashboard
BRAND_COLOR=#4f46e5

# ============================================================================
# Email & SMS - Console Providers (logs to console)
# ============================================================================
# No configuration needed - console providers enabled by default in auth.config.ts

# ============================================================================
# Social OAuth - Add credentials to enable (optional)
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET

APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_P8_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ============================================================================
# Features - Optional, leave empty to disable
# ============================================================================
PASSKEY_TIMEOUT=60000

# reCAPTCHA (.env name -> frontend build arg -> environment.prod.ts property)
# RECAPTCHA_ENABLED     -> RECAPTCHA_ENABLED     -> environment.recaptchaEnabled
# RECAPTCHA_VERSION     -> RECAPTCHA_VERSION     -> environment.recaptchaVersion
# RECAPTCHA_ENTERPRISE_SITE_KEY -> RECAPTCHA_SITE_KEY -> environment.recaptchaSiteKey
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=enterprise
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_SITE_KEY=

MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
