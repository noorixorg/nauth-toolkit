{
  "name": "demo-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test || echo 'No tests found, skipping...'",
    "e2e": "cd e2e && playwright test",
    "e2e:watch": "cd e2e playwright test --ui --headed --slow-mo=1000",
    "e2e:slow": "cd e2e && SLOWMO=1000 playwright test --headed",
    "e2e:debug": "cd e2e && SLOWMO=500 playwright test --ui --headed",
    "e2e:scenario": "cd e2e && node run-scenario.js",
    "e2e:ui": "cd e2e && SLOWMO=1000 playwright test --ui --headed",
    "e2e:headed": "cd e2e && SLOWMO=1000 playwright test --headed"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@faker-js/faker": "^10.1.0",
    "@nauth-toolkit/client": "file:../../packages/client/dist",
    "@nauth-toolkit/client-angular": "file:../../packages/client-angular/dist",
    "@primeuix/themes": "^2.0.2",
    "@simplewebauthn/browser": "^13.2.2",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^27.1.0",
    "otplib": "^12.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
