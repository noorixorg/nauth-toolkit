# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=nauth_sample

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:4200

# Trust proxy — REQUIRED when running behind a reverse proxy / load balancer so req.ip
# resolves the real client IP and forged X-Forwarded-For headers are ignored. nauth-toolkit
# keys IP-based account lockout, geolocation and audit on req.ip.
#   1            -> one proxy in front (e.g. Caddy/Nginx on dev/staging)
#   uniquelocal  -> AWS ELB/ALB (ECS, Copilot) and other private-network LBs (trusts private hops)
#   10.0.0.0/8   -> a specific proxy IP/CIDR
# Leave unset (or =false) when nothing proxies you. NEVER use `true` (re-enables spoofing).
# TRUST_PROXY=1

# ============================================================================
# JWT Secrets (REQUIRED)
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# Email Configuration (OPTIONAL)
# ============================================================================
# These variables populate the email templates
APP_NAME=My Application
COMPANY_NAME=My Company Inc.
SUPPORT_EMAIL=support@example.com

# ============================================================================
# Social OAuth — Google (OPTIONAL)
# ============================================================================
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Comma-separated administrator emails, read by RoleAuthorizer.
# Authority must live somewhere the user cannot write - never in user.metadata,
# which is caller-writable through signup and the self-service profile update.
ADMIN_EMAILS=
