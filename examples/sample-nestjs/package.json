    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@simplewebauthn/server": "^10.0.0",
    "dotenv": "^16.4.0",
    "jose": "^6.0.0",
    "mysql2": "^3.6.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
