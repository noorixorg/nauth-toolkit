# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL (default)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nauth_user
DB_PASSWORD=your_password_here
DB_DATABASE=nauth_sample

# MySQL (alternative)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=nauth_user
# DB_PASSWORD=your_password_here
# DB_DATABASE=nauth_sample

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# JWT Secrets (REQUIRED)
# ============================================================================
# Generate strong random secrets (min 32 chars recommended)
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# Email Configuration (OPTIONAL)
# ============================================================================
# Email Templates
TEMPLATE_APP_NAME=My Application
TEMPLATE_COMPANY_NAME=My Company Inc.
TEMPLATE_SUPPORT_EMAIL=support@example.com

# SMTP Configuration (for NodemailerEmailProvider)
# EMAIL_FROM=My App <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# ============================================================================
# SMS Configuration (OPTIONAL)
# ============================================================================
# AWS SNS Configuration (for AWSSNSProvider)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================================================
# Storage Adapter (OPTIONAL)
# ============================================================================
# Redis URL (for RedisStorageAdapter)
# REDIS_URL=redis://localhost:6379

# ============================================================================
# Social OAuth Providers (OPTIONAL)
# ============================================================================
# Google OAuth
# Register at: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Apple Sign-In
# Register at: https://developer.apple.com/account/
APPLE_CLIENT_ID=com.yourapp.services
# APPLE_CLIENT_SECRET=your-apple-client-secret-jwt

# Facebook OAuth
# Register at: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ============================================================================
# Geolocation (OPTIONAL)
# ============================================================================
# MaxMind GeoIP2
# Register at: https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_LICENSE_KEY=your-maxmind-license-key
MAXMIND_ACCOUNT_ID=your-maxmind-account-id

# ============================================================================
# Passkey Configuration (OPTIONAL)
# ============================================================================
# Comma-separated list of allowed origins for passkey authentication
# Example: http://localhost:4200,http://localhost:3000,https://angular.dev1.noorix.com
PASSKEY_ORIGINS=http://localhost:4200,http://localhost:3000,https://angular.dev1.noorix.com
# Passkey timeout in milliseconds (default: 60000)
PASSKEY_TIMEOUT=60000
