# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nauth_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=nauth_sample

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
PORT=3000

# ============================================================================
# Domain Configuration (CHANGE THESE FOR YOUR DEPLOYMENT)
# ============================================================================
# Frontend URL (where Angular app is hosted)
FRONTEND_BASE_URL=https://demo.yourdomain.com

# API URL (where NestJS backend is hosted)
API_BASE_URL=https://api.demo.yourdomain.com

# Passkey RP ID (typically the domain without protocol/port)
# Example: demo.yourdomain.com
PASSKEY_RP_ID=demo.yourdomain.com

# Cookie domain (use leading dot for subdomains: .yourdomain.com)
# Leave empty for single domain or use .demo.yourdomain.com for subdomains
COOKIE_DOMAIN=.demo.yourdomain.com

# ============================================================================
# JWT Secrets (GENERATE NEW SECRETS!)
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-change-this
JWT_REFRESH_SECRET=your-refresh-secret-here-change-this
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# App Branding
# ============================================================================
APP_NAME=Nauth Demo
COMPANY_NAME=Nauth Company
SUPPORT_EMAIL=support@yourdomain.com
LOGO_URL=https://www.example.com/logo.png
DASHBOARD_URL=https://demo.yourdomain.com/dashboard
BRAND_COLOR=#4f46e5

# ============================================================================
# Social OAuth - Google
# ============================================================================
# Register at: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# ============================================================================
# Social OAuth - Apple
# ============================================================================
# Register at: https://developer.apple.com/account/
APPLE_SERVICE_ID=com.yourapp.services
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Paste your entire .p8 key content here (include BEGIN/END lines)
APPLE_P8_KEY="-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----"

# ============================================================================
# Social OAuth - Facebook
# ============================================================================
# Register at: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ============================================================================
# Passkey Configuration
# ============================================================================
PASSKEY_TIMEOUT=60000

# ============================================================================
# reCAPTCHA Enterprise (Optional)
# ============================================================================
# Register at: https://cloud.google.com/recaptcha-enterprise
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=enterprise
RECAPTCHA_ENTERPRISE_PROJECT_ID=your-project-id
RECAPTCHA_ENTERPRISE_API_KEY=AIza...your-api-key
RECAPTCHA_ENTERPRISE_SITE_KEY=6L...your-site-key

# ============================================================================
# MaxMind GeoIP (Optional)
# ============================================================================
# Register at: https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_LICENSE_KEY=your-maxmind-license-key
MAXMIND_ACCOUNT_ID=123456
